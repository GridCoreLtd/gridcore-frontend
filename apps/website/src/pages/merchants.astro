import MerchantOurKey from "@/components/merchant/MerchantOurKey";
import MerchantHowItWorks from "@/components/merchant/MerchantHowItWorks";
import CallToAction from "@/components/shared/CallToAction";
---

<Layout title="Our Merchants">
  <MerchantHero />
