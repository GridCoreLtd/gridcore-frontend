# Copy to .env and fill in. Never commit real values.
# Astro exposes only PUBLIC_-prefixed variables to the browser, and inlines
# them into the built output. Nothing secret may go in this file.
#
# The old site put AWS access keys here (NEXT_PUBLIC_ACCESS_KEY_ID /
# NEXT_PUBLIC_SECRET_ACCESS_KEY) and shipped them to every visitor. No key
# reaches a browser now: documents are posted to the API with the application
# and stored server-side after a scan (D-032).

PUBLIC_WEBSITE_URL=https://gridcore.com
# Empty means same-origin: nginx serves /v1 from the Go API under the website's
# own host, so the application form posts first-party and needs no CORS.
PUBLIC_BASE_URL=

# The domain a merchant's portal is a subdomain of. Shown live under the short
# name on the application form, because that field IS their address (D-020).
PUBLIC_PORTAL_DOMAIN=gridcore.test.net

# The mock backend (pnpm mock) listens on 4000 and implements the error
# contract in architecture/10-api-errors.md. See mock-api/README.md.
