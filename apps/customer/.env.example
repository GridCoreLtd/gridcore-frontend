# Copy to .env.local and fill in. Never commit real values.
# Vite only exposes variables prefixed with VITE_ to the browser bundle —
# so nothing secret may ever go in this file.

VITE_BASE_URL=http://localhost:4000

# Paystack PUBLIC key only (pk_...). The secret key belongs on the backend.
VITE_PAYSTACK_KEY=
VITE_PAYSTACK_FLAT_FEE=
VITE_PAYSTACK_PERCENTAGE_FEE=

# The mock backend (pnpm mock) listens on 4000 and implements the error
# contract in architecture/10-api-errors.md. See mock-api/README.md.
