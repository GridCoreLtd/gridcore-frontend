{
  "name": "gridcore-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "mock": "pnpm --filter @gridcore/mock-api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss,astro}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,scss,astro}\""
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@parcel/watcher", "@swc/core", "esbuild", "sharp"]
  },
  "devDependencies": {
    "@gridcore/config": "workspace:*",
    "prettier": "catalog:",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "catalog:"
  }
}
